@startuml
hide footbox
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam dpi 240
skinparam defaultFontName SansSerif
skinparam defaultFontSize 16
skinparam ParticipantPadding 10
skinparam maxMessageSize 270
actor "Técnico" as A
boundary "painel:indicators.html" as I
participant "rotas:helpdesk.routes" as R <<módulo Flask>>
participant "chamados:helpdesk.tickets" as C <<módulo>>
participant "db.session:Session" as P <<infraestrutura>>
note over A,R : Precondição: técnico autenticado.\nrequire_user("tecnico") bloqueia os demais perfis antes da rota.
A -> I : Abrir Indicadores
I -> R : indicators()
activate R
R -> C : get_indicators(user)
activate C
alt perfil técnico confirmado na operação
 C -> P : execute(select(Ticket.status, count(Ticket.id))\n.group_by(Ticket.status))
 activate P
 P --> C : contagens por status
 deactivate P
 C -> P : execute(select(Ticket.priority, count(Ticket.id))\n.group_by(Ticket.priority))
 activate P
 P --> C : contagens por prioridade
 deactivate P
 note over C : Completa valores ausentes com zero.\nSem joins com histórico; conta somente chamados.
 C --> R : status e priority com todas as opções
else perfil não autorizado na operação
 C --> R : Forbidden
end
 deactivate C
alt contagens retornadas
 R --> I : duas tabelas de contagens reais
else Forbidden
 R --> I : acesso negado (Flask)
end
 deactivate R
I --> A : Apresentar contagens atuais
@enduml
