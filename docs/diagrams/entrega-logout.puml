@startuml
hide footbox
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam dpi 300
skinparam defaultFontName SansSerif
skinparam defaultFontSize 16
skinparam ParticipantPadding 12
skinparam maxMessageSize 210
actor "Usuário" as U
boundary "Interface" as I
control "Sistema" as S
U -> I : Selecionar Sair
I -> S : Solicitar saída
S --> I : Acesso encerrado
I --> U : Apresentar login e confirmação
@enduml
