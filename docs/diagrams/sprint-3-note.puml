@startuml
hide footbox
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam dpi 240
skinparam defaultFontName SansSerif
skinparam defaultFontSize 16
skinparam ParticipantPadding 10
skinparam maxMessageSize 270
actor "Técnico" as A
boundary "formulário:ticket_detail.html" as I
participant "rotas:helpdesk.routes" as R <<módulo Flask>>
participant "form:NoteForm" as F
participant "chamados:helpdesk.tickets" as C <<módulo>>
entity "anotacao:TicketNote" as N
participant "db.session:Session" as P <<infraestrutura>>
note over A,R : Precondição: técnico autenticado.\nSolicitante é bloqueado antes de executar a rota.
A -> I : Escrever anotação e enviar
I -> R : ticket_note(ticket_id)
activate R
R -> C : get_ticket(ticket_id, user)
activate C
C --> R : Ticket ou None
 deactivate C
break chamado inexistente
 R --> I : recurso não encontrado (Flask)
end
R -> F : validate_on_submit()
activate F
F --> R : válido ou erros
 deactivate F
break formulário inválido
 R -> R : ticket_detail_response(ticket, note_form=form, ...)
 R --> I : orientar correção; sem inclusão
end
newpage Continuação: inclusão da anotação
opt formulário válido
R -> C : add_note(ticket, user, content)
 activate C
 alt conteúdo válido após conferir o perfil
  create N
  C -> N : TicketNote(ticket=ticket, author=user, content=cleaned)
  C -> P : add(note)
  activate P
  P --> C : anotação pendente
  deactivate P
  C -> P : commit()
  activate P
  P --> C : confirmação ou SQLAlchemyError
  deactivate P
  C --> R : TicketNote ou erro propagado
 else conteúdo inválido na operação
  C --> R : ValueError
 end
 deactivate C
 alt inclusão confirmada
  R --> I : redirecionar ao detalhe e histórico
 else ValueError
  R -> P : rollback()
  activate P
  P --> R : transação desfeita
  deactivate P
  R -> R : ticket_detail_response(ticket, note_form=form, ...)
  R --> I : orientar correção
 else SQLAlchemyError
  R -> P : rollback()
  activate P
  P --> R : transação desfeita
  deactivate P
  R --> I : página de erro (Flask)
 end
end
 deactivate R
I --> A : Apresentar resultado
note over F : validate_on_submit() é herdado de FlaskForm.
note over C,P : A inclusão não modifica Ticket ou StatusEvent.\nO tratamento global da falha de persistência também chama rollback().
@enduml
