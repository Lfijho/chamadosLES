@startuml
' Versão de leitura para A4, derivada do diagrama detalhado de mesmo fluxo.
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
hide footbox
skinparam ParticipantPadding 10
skinparam BoxPadding 6
skinparam maxMessageSize 180
actor "Usuário" as U
boundary "Navegador" as B
control "Flask\nlogin / security" as F
database "SQLite\n(SQLAlchemy)" as D
U -> B : Informar e-mail e senha
B -> F : POST /login + CSRF
F -> F : Validar CSRF, LoginForm\ne limites de tentativas
F -> D : Consultar usuário e contadores
D --> F : Conta e limites
F -> F : authenticate(): verificar scrypt
alt Credenciais inválidas
  F -> D : Incrementar falhas e COMMIT
  F --> B : Mensagem genérica (200)
else Credenciais válidas
  F -> D : start_session(): gravar hash\ndo token e expiração UTC
  F --> B : 303 para destino seguro\ne cookie assinado
  B -> F : GET destino
  F -> D : load_user(): conferir sessão
  F --> B : Página do perfil (Jinja2)
end
note over B,F
  CSRF inválido: 400; campos inválidos: 422.
  Limite de tentativas: 429.
  next externo ou desconhecido retorna a /.
end note
@enduml
