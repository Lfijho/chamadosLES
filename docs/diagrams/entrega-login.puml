@startuml
hide footbox
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam dpi 300
skinparam defaultFontName SansSerif
skinparam defaultFontSize 16
skinparam ParticipantPadding 12
skinparam maxMessageSize 210
actor "Usuário" as U
boundary "Interface" as I
control "Sistema" as S
database "Banco de dados" as B
U -> I : Informar e-mail e senha
I -> S : login()
S -> B : Consultar usuário
B --> S : Dados da conta
S -> S : authenticate(user, password)
S -> S : User.check_password(password)\nSe a conta existir
alt Dados válidos
  S -> S : start_session(user)
  S --> I : Abrir página inicial
  I -> S : home()
  S --> I : Página do perfil
else Dados inválidos
  S --> I : Informar dados incorretos
end
I --> U : Apresentar resultado
@enduml
