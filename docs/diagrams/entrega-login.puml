@startuml
hide footbox
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam dpi 300
skinparam defaultFontName SansSerif
skinparam defaultFontSize 16
skinparam ParticipantPadding 12
skinparam maxMessageSize 210
actor "Usuário" as U
boundary "Interface" as I
control "Sistema" as S
database "Banco de dados" as B
U -> I : Informar e-mail e senha
I -> S : Solicitar acesso
S -> B : Consultar usuário
B --> S : Dados da conta
alt Dados válidos
  S --> I : Permitir acesso ao perfil
else Dados inválidos
  S --> I : Informar dados incorretos
end
I --> U : Apresentar resultado
@enduml
