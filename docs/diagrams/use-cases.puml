@startuml
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam actorStyle awesome
actor "Usuário" as User <<abstrato>>
actor "Solicitante" as Requester
actor "Técnico" as Tech
Requester --|> User
Tech --|> User
rectangle "HelpDesk — Sprint 1" {
  usecase "UC01\nRealizar login" as Login
  usecase "UC02\nRealizar logout" as Logout
  usecase "UC03\nAbrir chamado" as Open
}
User -- Login
User -- Logout
Requester -- Open
note right of Open
  Precondição: solicitante autenticado.
  Inclui confirmação privada da abertura.
end note
rectangle "Ferramenta auxiliar acadêmica" {
  usecase "Consultar quadro\ndo projeto" as Board
  usecase "Mover tarefa" as Move
}
Tech -- Board
Tech -- Move
note bottom of Board
  Kanban de tarefas, separado dos
  requisitos funcionais dos chamados.
end note
@enduml
