{rank=same; start; h0; t0;}
{rank=same; opening_merge; h1; t1;}
{rank=same; opening; validate_opening; t2;}
{rank=same; s3; valid_opening; t3;}
{rank=same; s4; save; read;}
{rank=same; s5; h5; change_priority;}
{rank=same; s6; save_priority; priority;}
{rank=same; s7; h7; priority_merge;}
{rank=same; s8; in_progress; begin;}
{rank=same; s9; continue_a; t9;}
start -> opening_merge [label=""];
opening_merge -> opening [label=""];
opening -> validate_opening [label=""];
validate_opening -> valid_opening [label=""];
valid_opening -> opening_merge [label="[não]", constraint=false];
valid_opening -> save [label="[sim]"];
save -> read [label=""];
read -> change_priority [label=""];
change_priority -> priority [label="[sim]"];
priority -> save_priority [label=""];
save_priority -> priority_merge [label=""];
change_priority -> priority_merge [label="[não]", constraint=false];
priority_merge -> begin [label=""];
begin -> in_progress [label=""];
in_progress -> continue_a [label=""];
}
