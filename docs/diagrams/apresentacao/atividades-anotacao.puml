@startdot
digraph Anotacao {
graph [newrank=true, ranksep=0.16, nodesep=0.55, dpi=160, bgcolor="white", pad=0.15];
node [fontname="SansSerif", fontsize=24, color="#18353e", penwidth=2, margin="0.18,0.08"];
edge [fontname="SansSerif", fontsize=22, color="#126759", penwidth=2, arrowsize=0.8];
subgraph cluster_s {
 label="Solicitante";fontsize=28;fontname="SansSerif";color="#aabbb4";
 s0 [shape=point,style=invis];s1 [shape=point,style=invis];s2 [shape=point,style=invis];
 s3 [shape=plaintext,label="Consulta o histórico;\nnão adiciona anotações.",fontcolor="#526a70",fontsize=22];
 s4 [shape=point,style=invis];s5 [shape=point,style=invis];s6 [shape=point,style=invis];s7 [shape=point,style=invis];
 s0 -> s1 -> s2 -> s3 -> s4 -> s5 -> s6 -> s7 [style=invis,weight=100];
}
subgraph cluster_h {
 label="HelpDesk";fontsize=28;fontname="SansSerif";color="#aabbb4";
 h0 [shape=point,style=invis];h1 [shape=point,style=invis];h2 [shape=point,style=invis];h3 [shape=point,style=invis];
 validate [shape=box,style="rounded,filled",fillcolor="#edf5ee",label="Validar texto"];
 valid [shape=diamond,label="Texto\nválido?",width=1.2,height=0.8];
 save [shape=box,style="rounded,filled",fillcolor="#edf5ee",label="Incluir anotação com autor e UTC;\npreservar o atendimento"];
 view [shape=box,style="rounded,filled",fillcolor="#edf5ee",label="Exibir histórico atualizado"];
 h0 -> h1 -> h2 -> h3 -> validate -> valid -> save -> view [style=invis,weight=100];
}
subgraph cluster_t {
 label="Técnico";fontsize=28;fontname="SansSerif";color="#aabbb4";
 a [shape=circle,label="A",width=0.45,height=0.45,fixedsize=true];
 merge [shape=diamond,label="",width=0.22,height=0.22,fixedsize=true];
 choice [shape=diamond,label="Adicionar\nanotação?",width=1.4,height=0.8];
 write [shape=box,style="rounded,filled",fillcolor="#edf5ee",label="Escrever ou corrigir\nanotação e enviar"];
 t4 [shape=point,style=invis];
 fix [shape=box,style="rounded,filled",fillcolor="#edf5ee",label="Receber orientação;\ncorrigir ou cancelar"];
 t6 [shape=point,style=invis];
 end [shape=doublecircle,label="",width=0.20,height=0.20,style=filled,fillcolor="#18353e"];
 a -> merge -> choice -> write -> t4 -> fix -> t6 -> end [style=invis,weight=100];
}
{rank=same;s0;h0;a;} {rank=same;s1;h1;merge;} {rank=same;s2;h2;choice;}
{rank=same;s3;h3;write;} {rank=same;s4;validate;t4;} {rank=same;s5;valid;fix;}
{rank=same;s6;save;t6;} {rank=same;s7;view;end;}
a -> merge -> choice;choice -> write [label="[sim]"];
choice -> end [label="[não]",constraint=false];
write -> validate -> valid;valid -> save [label="[sim]"];
valid -> fix [label="[não]"];fix -> merge [constraint=false];
save -> view -> end;
}
@enddot
