@startuml
hide footbox
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam dpi 160
skinparam defaultFontName SansSerif
skinparam defaultFontSize 24
skinparam ParticipantPadding 5
skinparam maxMessageSize 600
skinparam sequenceMessageAlign center
skinparam ArrowColor #18353e
skinparam ParticipantBackgroundColor #e8f3ee
skinparam ParticipantBorderColor #126759
skinparam ActorBorderColor #18353e
skinparam LifeLineBorderColor #aabbb4
skinparam sequenceGroupBackgroundColor #f5f8f6
actor "Técnico" as A
boundary "painel:indicators.html" as I
participant "rotas:helpdesk.routes" as R <<módulo Flask>>
participant "operacoes:helpdesk.tickets" as C <<módulo>>
participant "db.session:Session" as P <<infraestrutura>>
A -> I : Abrir Indicadores
I -> R : indicators()
activate R
R -> C : get_indicators(user)
activate C
alt perfil técnico confirmado
 C -> P : execute(select(Ticket.status, count(Ticket.id))\n.group_by(Ticket.status))
 activate P
 P --> C : contagens por status
 deactivate P
 C -> P : execute(select(Ticket.priority, count(Ticket.id))\n.group_by(Ticket.priority))
 activate P
 P --> C : contagens por prioridade
 deactivate P
 note right of C : Opções ausentes recebem zero.\nSem junção com o histórico.
 C --> R : contagens
else perfil não autorizado
 C --> R : Acesso negado
end
deactivate C
alt contagens retornadas
 R --> I : Duas tabelas atualizadas
else perfil não autorizado
 R --> I : Informar restrição
end
deactivate R
I --> A : Apresentar resultado
@enduml
