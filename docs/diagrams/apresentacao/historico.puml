@startuml
hide footbox
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam dpi 160
skinparam defaultFontName SansSerif
skinparam defaultFontSize 24
skinparam ParticipantPadding 5
skinparam maxMessageSize 480
skinparam sequenceMessageAlign center
skinparam ArrowColor #18353e
skinparam ParticipantBackgroundColor #e8f3ee
skinparam ParticipantBorderColor #126759
skinparam LifeLineBorderColor #aabbb4
skinparam sequenceGroupBackgroundColor #f5f8f6
skinparam sequenceMessageSpacing 4
actor "Solicitante\nou técnico" as A
boundary "tela:ticket_detail.html" as I
participant "rotas:helpdesk.routes" as R <<módulo Flask>>
participant "operacoes:helpdesk.tickets" as C <<módulo>>
participant "db.session:Session" as P <<infraestrutura>>
A -> I : Selecionar chamado existente
I -> R : ticket_detail(ticket_id)
activate R
R -> C : get_ticket(ticket_id, user)
activate C
C --> R : Ticket ou None
deactivate C
alt chamado autorizado
 R -> R : ticket_detail_response(ticket)
 R -> C : get_history(ticket, user)
 activate C
 C -> P : execute(união ordenada de StatusEvent e TicketNote)
 activate P
 P --> C : registros com autor e data UTC
 deactivate P
 C --> R : histórico cronológico
 deactivate C
 R --> I : Histórico ou estado vazio
else chamado inexistente ou não visível ao usuário atual
 R --> I : Informar indisponibilidade
end
deactivate R
I --> A : Apresentar resultado
@enduml
