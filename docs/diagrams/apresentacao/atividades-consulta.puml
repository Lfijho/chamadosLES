@startdot
digraph Consulta {
graph [newrank=true, ranksep=0.18, nodesep=0.45, dpi=160, bgcolor="white", pad=0.15];
node [fontname="SansSerif", fontsize=24, color="#18353e", penwidth=2, margin="0.18,0.08"];
edge [fontname="SansSerif", fontsize=22, color="#126759", penwidth=2, arrowsize=0.8];
subgraph cluster_s {
 label="Solicitante"; fontsize=28; fontname="SansSerif"; color="#aabbb4";
 s0 [shape=point,style=invis];s1 [shape=point,style=invis];s2 [shape=point,style=invis];
 own [shape=box,style="rounded,filled",fillcolor="#edf5ee",label="Selecionar chamado\npróprio"];
 s4 [shape=point,style=invis];s5 [shape=point,style=invis];s6 [shape=point,style=invis];
 end [shape=doublecircle,label="",width=0.20,height=0.20,style=filled,fillcolor="#18353e"];
 s0 -> s1 -> s2 -> own -> s4 -> s5 -> s6 -> end [style=invis,weight=100];
}
subgraph cluster_h {
 label="HelpDesk"; fontsize=28; fontname="SansSerif"; color="#aabbb4";
 start [shape=circle,label="",width=0.18,height=0.18,style=filled,fillcolor="#18353e"];
 auth [shape=box,style="rounded,filled",fillcolor="#edf5ee",label="Usuário autenticado"];
 role [shape=diamond,label="Perfil?",width=1.3,height=0.7];
 h3 [shape=point,style=invis];
 merge [shape=diamond,label="",width=0.22,height=0.22,fixedsize=true];
 read [shape=box,style="rounded,filled",fillcolor="#edf5ee",label="Consultar registros reais\ndo chamado autorizado"];
 view [shape=box,style="rounded,filled",fillcolor="#edf5ee",label="Exibir histórico cronológico\nou estado vazio"];
 choice [shape=diamond,label="Perfil?",width=1.3,height=0.7];
 start -> auth -> role -> h3 -> merge -> read -> view -> choice [style=invis,weight=100];
}
subgraph cluster_t {
 label="Técnico"; fontsize=28; fontname="SansSerif"; color="#aabbb4";
 t0 [shape=point,style=invis];t1 [shape=point,style=invis];t2 [shape=point,style=invis];
 any [shape=box,style="rounded,filled",fillcolor="#edf5ee",label="Selecionar chamado\nde qualquer solicitante"];
 t4 [shape=point,style=invis];t5 [shape=point,style=invis];t6 [shape=point,style=invis];
 a [shape=circle,label="A",width=0.45,height=0.45,fixedsize=true];
 t0 -> t1 -> t2 -> any -> t4 -> t5 -> t6 -> a [style=invis,weight=100];
}
{rank=same;s0;start;t0;} {rank=same;s1;auth;t1;} {rank=same;s2;role;t2;}
{rank=same;own;h3;any;} {rank=same;s4;merge;t4;} {rank=same;s5;read;t5;}
{rank=same;s6;view;t6;} {rank=same;end;choice;a;}
start -> auth -> role;
role -> own [label="[solicitante]"];role -> any [label="[técnico]"];
own -> merge;any -> merge;merge -> read -> view -> choice;
choice -> end [label="[solicitante]"];choice -> a [label="[técnico]"];
}
@enddot
