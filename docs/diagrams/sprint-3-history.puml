@startuml
hide footbox
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam dpi 240
skinparam defaultFontName SansSerif
skinparam defaultFontSize 16
skinparam ParticipantPadding 10
skinparam maxMessageSize 270
actor "Solicitante ou técnico" as A
boundary "detalhes:ticket_detail.html" as I
participant "rotas:helpdesk.routes" as R <<módulo Flask>>
participant "chamados:helpdesk.tickets" as C <<módulo>>
participant "db.session:Session" as P <<infraestrutura>>
note over A,R : Precondição: usuário autenticado.\nSolicitante consulta próprios; técnico consulta todos.
A -> I : Consultar histórico de um chamado
I -> R : ticket_detail(ticket_id)
activate R
R -> C : get_ticket(ticket_id, user)
activate C
C -> C : visible_tickets(user)
C -> P : scalar(consulta autorizada)
activate P
P --> C : Ticket ou None
 deactivate P
C --> R : Ticket ou None
 deactivate C
alt chamado inexistente ou não visível ao usuário atual
  R --> I : recurso não encontrado (Flask)
else chamado autorizado
  R -> R : ticket_detail_response(ticket)
  R -> C : get_history(ticket, user)
  activate C
  note over C : Confere perfil e propriedade antes da consulta.
  C -> P : execute(união de StatusEvent e TicketNote,\nordenada por occurred_at, event_order e id)
  activate P
  P --> C : registros com autor e data UTC
  deactivate P
  C --> R : histórico cronológico
  deactivate C
  alt registros existentes
    R --> I : linha do tempo com status e anotações
  else nenhum registro
    R --> I : estado de histórico vazio
  end
end
 deactivate R
I --> A : Apresentar histórico permitido
@enduml
