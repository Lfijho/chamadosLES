@startuml
hide footbox
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam dpi 240
skinparam defaultFontName SansSerif
skinparam defaultFontSize 16
skinparam ParticipantPadding 16
skinparam maxMessageSize 230
actor "Solicitante ou técnico" as A
boundary "Lista / detalhes" as I
participant "rotas:helpdesk.routes" as R <<módulo Flask>>
participant "chamados:helpdesk.tickets" as C <<módulo>>
participant "db.session:Session" as P <<infraestrutura>>
A -> I : Selecionar um chamado existente
I -> R : ticket_detail(ticket_id)
activate R
R -> C : get_ticket(ticket_id, user)
activate C
C -> C : visible_tickets(user)
note right of C : Solicitante: próprios. Técnico: todos.
C -> P : scalar(consulta por id e permissão)
activate P
P --> C : ticket:Ticket ou None
deactivate P
C --> R : chamado autorizado ou None
deactivate C
alt chamado visível
  R -> R : ticket_detail_response(ticket)
  R --> I : dados e ações do perfil
else chamado inexistente ou não visível ao usuário atual
  R --> I : página de chamado não encontrado
end
deactivate R
I --> A : Apresentar resultado
@enduml
